<Window x:Class="OnPropertyChanged.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnPropertyChanged"
        mc:Ignorable="d"
        Title="OnPropertyChanged" Height="140" Width="300">
    <Grid>
        
        
        <StackPanel>
            
            <TextBox Text="{Binding TextBoxText}" Width="200" Height="40" Margin="10"></TextBox>
            <Label Content="{Binding LabelText}" Width="200" Height="40" Margin="10"></Label>
            
        </StackPanel>
        
        
    </Grid>
</Window>
